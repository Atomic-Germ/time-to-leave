{
    "all": true,
    "include": [
        "js/**/*.{cjs,js,mjs}", 
        "src/**/*.{cjs,js,mjs}", 
        "main.{cjs,js,mjs}",
        "renderer/**/*.{cjs,js,mjs}"
    ],
    "exclude": [
        "**/__tests__/**", 
        "**/node_modules/**", 
        "coverage*/**",
        "**/*.config.{cjs,js,mjs}",
        "**/configs/**",
        "scripts/**",
        "docs/**"
    ],
    "reporter": ["clover", "json", "lcov", "text", "html"],
    "report-dir": "coverage_nyc",
    "temp-dir": "./coverage_nyc/.nyc_output",
    "instrument": true,
    "sourceMap": false,
    "produce-source-map": false,
    "cache": false,
    "hook-require": true,
    "hook-run-in-context": true,
    "hook-run-in-this-context": true,
    "es-modules": true,
    "check-coverage": false,
    "per-file": true,
    "lines": 80,
    "statements": 80,
    "functions": 80,
    "branches": 80
}